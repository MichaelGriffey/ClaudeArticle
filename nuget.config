<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One explicit source, mapped for every package: no dependency confusion from machine-level feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
